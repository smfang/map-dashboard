{
  "name": "nft-factory-project",
  "version": "1.0.0",
  "description": "NFT Factory and NFT Contract Deployment with Tenderly Integration",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:tenderly": "hardhat run scripts/deploy.js --network tenderly",
    "deploy:tenderly-fork": "hardhat run scripts/deploy.js --network tenderlyFork",
    "deploy:base-sepolia": "cd solidity && hardhat run scripts/deploy.js --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "hardhat": "^2.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@tenderly/hardhat-tenderly": "^2.5.2",
    "dotenv": "^16.0.3",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "nft",
    "ethereum",
    "smart-contracts",
    "tenderly",
    "debugging"
  ],
  "author": "Your Name",
  "license": "MIT"
}
